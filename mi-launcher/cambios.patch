+        v.setSingleLine(true);
+        v.setGravity(Gravity.CENTER_HORIZONTAL);
+        v.setPadding(0, Math.round(1 * dp), 0, Math.round(1 * dp));
+        return v;
+    }
+
+    private View pill(String text, View.OnClickListener click) {
+        TextView pill = new TextView(activity);
