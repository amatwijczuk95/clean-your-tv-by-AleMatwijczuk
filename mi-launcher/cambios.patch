+        bg.setStroke(Math.round(1 * dp), 0x1FFFFFFF);
+        card.setBackground(bg);
+        int pad = Math.round(10 * dp);
+        card.setPadding(pad, pad, Math.round(16 * dp), pad);
+        card.setAlpha(0f);
+        card.setVisibility(View.GONE);
+        card.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+
+        art = new ImageView(ctx);
+        art.setScaleType(ImageView.ScaleType.CENTER_CROP);
+        art.setBackgroundColor(0x33FFFFFF);
+        final float r = 8 * dp;
+        art.setOutlineProvider(new ViewOutlineProvider() {
+            @Override public void getOutline(View v, Outline o) { o.setRoundRect(0, 0, v.getWidth(), v.getHeight(), r); }
+        });
+        art.setClipToOutline(true);
+        int a = Math.round(48 * dp);
+        card.addView(art, new LinearLayout.LayoutParams(a, a));
+
+        LinearLayout text = new LinearLayout(ctx);
+        text.setOrientation(LinearLayout.VERTICAL);
+        text.setPadding(Math.round(12 * dp), 0, 0, 0);
+        source = label(11f, 0x99FFFFFF);
+        source.setLetterSpacing(0.12f);
+        source.setAllCaps(true);
+        title = label(15f, 0xF2FFFFFF);
+        artist = label(13f, 0xA6FFFFFF);
+        text.addView(source);
+        text.addView(title);
+        text.addView(artist);
+        card.addView(text, new LinearLayout.LayoutParams(Math.round(240 * dp), ViewGroup.LayoutParams.WRAP_CONTENT));
+        prevBtn = button(R.drawable.ic_np_prev);
+        playBtn = button(R.drawable.ic_np_play);
+        nextBtn = button(R.drawable.ic_np_next);
+        prevBtn.setOnClickListener(v -> previous());
+        playBtn.setOnClickListener(v -> playPause());
+        nextBtn.setOnClickListener(v -> next());
+        ((LinearLayout.LayoutParams) prevBtn.getLayoutParams()).setMarginStart(Math.round(14 * dp));
+
+        FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.TOP | Gravity.START);
+        lp.leftMargin = Math.round(56 * dp);
+        lp.topMargin = Math.round(122 * dp);
+        root.addView(card, lp);
+    }
+
+    private ImageView button(int icon) {
+        ImageView b = new ImageView(ctx);
+        b.setImageResource(icon);
+        b.setScaleType(ImageView.ScaleType.CENTER);
+        b.setFocusable(false);
+        b.setImageTintList(android.content.res.ColorStateList.valueOf(0xE6FFFFFF));
+        b.setBackground(buttonBackground(false));
+        b.setOnFocusChangeListener((v, has) -> {
+            v.setBackground(buttonBackground(has));
+            ((ImageView) v).setImageTintList(android.content.res.ColorStateList.valueOf(has ? 0xFF101010 : 0xE6FFFFFF));
+            v.animate().scaleX(has ? 1.1f : 1f).scaleY(has ? 1.1f : 1f).setDuration(DownDrawer.ms(160)).start();
+        });
+        int size = Math.round(40 * dp);
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(size, size);
+        lp.setMarginStart(Math.round(6 * dp));
+        card.addView(b, lp);
+        return b;
+    }
+
+    private GradientDrawable buttonBackground(boolean focused) {
+        GradientDrawable d = new GradientDrawable();
+        d.setShape(GradientDrawable.OVAL);
+        d.setColor(focused ? 0xF2FFFFFF : 0x26FFFFFF);
+        return d;
+    }
+
+    private boolean inCard(View v) {
+        for (Object p = v; p instanceof View; p = ((View) p).getParent()) if (p == card) return true;
+        return false;
+    }
+
+    /**
+     * Up from the dock goes to the card's play button while the card is up; Down from the card goes back to the
+     * dock tile it came from. Left and Right stay among the three buttons.
+     */
+    boolean onKey(android.view.KeyEvent e, View focus, FocusHost host) {
+        focusHost = host;
+        int code = e.getKeyCode();
+        boolean down = e.getAction() == android.view.KeyEvent.ACTION_DOWN;
+        boolean onCard = focus != null && inCard(focus);
+        if (!onCard) {
+            if (!shown || code != android.view.KeyEvent.KEYCODE_DPAD_UP) return false;
+            int pos = host.dockFocus();
+            if (pos < 0) return false;
+            if (down) {
+                returnTo = pos;
+                host.hideGlass();
+                playBtn.requestFocus();
+            }
+            return true;
+        }
+        switch (code) {
+            case android.view.KeyEvent.KEYCODE_DPAD_DOWN:
+                if (down) host.focusDock(returnTo);
+                return true;
+            case android.view.KeyEvent.KEYCODE_DPAD_UP:
+                return true;
+            case android.view.KeyEvent.KEYCODE_DPAD_LEFT:
+                if (down && focus == playBtn) prevBtn.requestFocus();
+                else if (down && focus == nextBtn) playBtn.requestFocus();
+                return true;
+            case android.view.KeyEvent.KEYCODE_DPAD_RIGHT:
+                if (down && focus == prevBtn) playBtn.requestFocus();
+                else if (down && focus == playBtn) nextBtn.requestFocus();
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    private void setButtonsFocusable(boolean on) {
+        for (View b : new View[]{prevBtn, playBtn, nextBtn}) {
+            b.setFocusable(on);
+            b.setFocusableInTouchMode(on);
+        }
+    }
+
+    private TextView label(float size, int color) {
+        TextView t = new TextView(ctx);
+        t.setTextSize(size);
+        t.setTextColor(color);
+        t.setSingleLine(true);
+        t.setEllipsize(android.text.TextUtils.TruncateAt.END);
+        return t;
+    }
+
+    void setListener(Listener l) {
+        onChange = l;
+    }
+
+    void resume() {
+        resumed = true;
+        armed = false;
+        pausedAt = 0;
+        try {
+            msm.addOnActiveSessionsChangedListener(sessions, listener);
+        } catch (SecurityException e) {
+            return;   // no notification access granted: nothing to show
+        }
+        pick();
+    }
+
+    void pause() {
+        resumed = false;
+        handler.removeCallbacks(recheck);
+        try {
+            msm.removeOnActiveSessionsChangedListener(sessions);
+        } catch (Exception ignored) {
+            // not registered
+        }
+        if (controller != null) controller.unregisterCallback(callback);
+        // Forget it: on the next resume pick() registers the callback again. Keeping it here left the same session
+        // without a callback after any trip away from Home, so track and play/pause changes stopped showing.
+        controller = null;
+        handler.removeCallbacks(poll);
+    }
+
+    /** Takes the session that is playing, else the most recent one that is paused. */
+    private void pick() {
+        if (!resumed) return;
+        List<MediaController> list;
+        try {
+            list = msm.getActiveSessions(listener);
+        } catch (SecurityException e) {
+            list = null;
+        }
+        MediaController best = null;
+        if (list != null) {
+            for (MediaController c : list) {
+                PlaybackState s = c.getPlaybackState();
+                if (s == null || c.getMetadata() == null) continue;
+                if (s.getState() == PlaybackState.STATE_PLAYING) { best = c; break; }
+                if (best == null && s.getState() == PlaybackState.STATE_PAUSED) best = c;
+            }
+        }
+        if (controller != null && (best == null || !controller.getSessionToken().equals(best.getSessionToken()))) {
+            controller.unregisterCallback(callback);
+        }
+        if (best != null && (controller == null || !controller.getSessionToken().equals(best.getSessionToken()))) {
+            best.registerCallback(callback);
+        }
+        controller = best;
+        refresh();
+    }
+
+    private void refresh() {
+        MediaController c = controller;
+        PlaybackState s = c == null ? null : c.getPlaybackState();
+        MediaMetadata m = c == null ? null : c.getMetadata();
+        handler.removeCallbacks(recheck);
+        // Shown only for music the user left playing: armed when Home sees it playing, never for a session that was
+        // already paused (or stale) when Home came up. After a pause it stays HIDE_PAUSED_MS, then disarms.
+        boolean playing = s != null && m != null && isPlaying();
+        boolean show = playing;
+        if (playing) {
+            armed = true;
+            pausedAt = 0;
+        } else if (armed && s != null && m != null && s.getState() == PlaybackState.STATE_PAUSED) {
+            long now = android.os.SystemClock.elapsedRealtime();
+            if (pausedAt == 0) pausedAt = now;
+            long left = HIDE_PAUSED_MS - (now - pausedAt);
+            show = left > 0;
+            if (show && resumed) handler.postDelayed(recheck, left + 500);
+            else armed = false;
+        } else {
+            armed = false;
+        }
+        shown = show;
+        handler.removeCallbacks(poll);
+        if (show && resumed) handler.postDelayed(poll, 3000);
+        if (show) {
+            String t = m.getString(MediaMetadata.METADATA_KEY_TITLE);
+            String ar = m.getString(MediaMetadata.METADATA_KEY_ARTIST);
+            if (ar == null) ar = m.getString(MediaMetadata.METADATA_KEY_ALBUM_ARTIST);
+            title.setText(t == null ? "" : t);
+            artist.setText(ar == null ? "" : ar);
+            String app = appName(c.getPackageName());
+            source.setText(ctx.getString(isPlaying() ? R.string.now_playing_on : R.string.now_paused_on, app));
+            Bitmap b = m.getBitmap(MediaMetadata.METADATA_KEY_ALBUM_ART);
+            if (b == null) b = m.getBitmap(MediaMetadata.METADATA_KEY_ART);
+            if (b == null) b = m.getBitmap(MediaMetadata.METADATA_KEY_DISPLAY_ICON);
+            if (b != null) {
+                int size = Math.round(48 * dp);
+                art.setImageBitmap(b.getWidth() > size * 2 ? Bitmap.createScaledBitmap(b, size, size, true) : b);
+            } else {
+                art.setImageDrawable(null);
+            }
+            if (card.getVisibility() != View.VISIBLE) {
+                card.setVisibility(View.VISIBLE);
+                card.setTranslationY(8 * dp);
+                card.animate().alpha(1f).translationY(0f).setDuration(DownDrawer.ms(260)).start();
+            }
+            playBtn.setImageResource(isPlaying() ? R.drawable.ic_np_pause : R.drawable.ic_np_play);
+            setButtonsFocusable(true);
+        } else if (card.getVisibility() == View.VISIBLE) {
+            // Leaving while selected: hand focus back to the dock first, then make the buttons unreachable, so focus
+            // never lands on a fading (or gone) button where OK would press Play unseen.
+            if (card.findFocus() != null && focusHost != null) focusHost.focusDock(returnTo);
+            setButtonsFocusable(false);
+            card.animate().alpha(0f).setDuration(DownDrawer.ms(200)).withEndAction(() -> card.setVisibility(View.GONE)).start();
+        }
+        if (onChange != null) onChange.changed();
+    }
+
+    private String appName(String pkg) {
+        try {
+            PackageManager pm = ctx.getPackageManager();
+            return String.valueOf(pm.getApplicationLabel(pm.getApplicationInfo(pkg, 0)));
+        } catch (Exception e) {
+            return pkg;
+        }
+    }
+
+    boolean active() {
+        return shown;
+    }
+
+    /** Playing, or about to (buffering, connecting, seeking): a press then means Pause, never Play. */
+    boolean isPlaying() {
+        PlaybackState s = controller == null ? null : controller.getPlaybackState();
+        if (s == null) return false;
+        switch (s.getState()) {
+            case PlaybackState.STATE_PLAYING:
+            case PlaybackState.STATE_BUFFERING:
+            case PlaybackState.STATE_CONNECTING:
+            case PlaybackState.STATE_FAST_FORWARDING:
+            case PlaybackState.STATE_REWINDING:
+            case PlaybackState.STATE_SKIPPING_TO_NEXT:
+            case PlaybackState.STATE_SKIPPING_TO_PREVIOUS:
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    /** One command per press: a second press within 700 ms (a bounce or a held OK) is ignored. */
+    private boolean debounced() {
+        long now = android.os.SystemClock.uptimeMillis();
+        if (now - lastCommand < 700) return false;
+        lastCommand = now;
+        return true;
+    }
+
+    void playPause() {
+        if (controller == null || !debounced()) return;
+        if (isPlaying()) controller.getTransportControls().pause();
+        else controller.getTransportControls().play();
+    }
+
+    void next() {
+        if (controller != null && debounced()) controller.getTransportControls().skipToNext();
+    }
+
+    void previous() {
+        if (controller != null && debounced()) controller.getTransportControls().skipToPrevious();
+    }
+
+    /** Hide or show the card with the Down panel, which covers that part of Home. */
+    void setHidden(boolean hidden) {
+        card.animate().cancel();
+        if (card.getVisibility() == View.VISIBLE) card.animate().alpha(hidden ? 0f : 1f).setDuration(DownDrawer.ms(200)).start();
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/SleepTimer.java b/launcher/app/src/main/java/com/gathin/tvhome/SleepTimer.java
new file mode 100644
index 00000000..ea69b21d
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/SleepTimer.java
@@ -0,0 +1,61 @@
+package com.gathin.tvhome;
+
+import android.app.AlarmManager;
+import android.app.PendingIntent;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+
+/**
+ * Local addition (theme key "sleep_timer"): puts the TV to sleep after 30, 60, 90 or 120 minutes, chosen in the
+ * Down panel. The end time is kept, so the countdown shows on Home; at the end an alarm asks HomeKeyService (the
+ * remote helper, an accessibility service) for the system's sleep action. Nothing runs between those two moments.
+ */
+final class SleepTimer {
+    static final int[] OPTIONS = {0, 30, 60, 90, 120};
+    private static final String PREFS = "sleep_timer", END = "end";
+
+    private SleepTimer() {
+    }
+
+    private static SharedPreferences prefs(Context c) {
+        return c.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    /** Minutes left, rounded up; 0 when no timer is set (or it already ran). */
+    static int minutesLeft(Context c) {
+        long left = prefs(c).getLong(END, 0) - System.currentTimeMillis();
+        return left <= 0 ? 0 : (int) ((left + 59_999) / 60_000);
+    }
+
+    /** The next choice after the current one: off → 30 → 60 → 90 → 120 → off. */
+    static int next(Context c) {
+        int now = minutesLeft(c);
+        for (int o : OPTIONS) if (o > now) return o;
+        return 0;
+    }
+
+    static void set(Context c, int minutes) {
+        AlarmManager am = c.getSystemService(AlarmManager.class);
+        PendingIntent pi = PendingIntent.getBroadcast(c, 0, new Intent(c, Receiver.class),
+                PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT);
+        if (minutes <= 0) {
+            prefs(c).edit().remove(END).apply();
+            if (am != null) am.cancel(pi);
+            return;
+        }
+        long end = System.currentTimeMillis() + minutes * 60_000L;
+        prefs(c).edit().putLong(END, end).apply();
+        if (am != null) am.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, end, pi);
+    }
+
+    /** The alarm: clear the timer and put the TV to sleep. */
+    public static final class Receiver extends BroadcastReceiver {
+        @Override
+        public void onReceive(Context c, Intent intent) {
+            prefs(c).edit().remove(END).apply();
+            HomeKeyService.sleepNow();
+        }
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/VideoBackdrop.java b/launcher/app/src/main/java/com/gathin/tvhome/VideoBackdrop.java
new file mode 100644
index 00000000..80fc5e28
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/VideoBackdrop.java
@@ -0,0 +1,270 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.SurfaceTexture;
+import android.media.MediaPlayer;
+import android.net.Uri;
+import android.os.SystemClock;
+import android.view.Surface;
+import android.view.TextureView;
+import android.view.View;
+import android.view.ViewGroup;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Local experiment (theme key "video_wallpaper"): muted videos behind Home, from res/raw/bg_video_1, _2, ...
+ * Two stacked layers make the loop seamless: about 2.5 s before a clip ends the other layer prepares the same clip
+ * from its start (or the next clip, shuffled, once video_rotation_minutes have passed) and cross-fades over it, so
+ * there is never a hard restart. At most two players exist, and the old one is released as soon as the fade ends;
+ * stop() releases both, so no decoder is held while an app runs. If the second player cannot start (a decoder
+ * busy elsewhere), the clip simply restarts on the same layer, as before.
+ */
+final class VideoBackdrop {
+    private static final long PREPARE_BEFORE_END_MS = 2500;
+    private static final long FADE_MS = 1500;
+
+    /** One video layer: a TextureView and, while it plays, its player. */
+    private final class Slot implements TextureView.SurfaceTextureListener {
+        final TextureView view;
+        MediaPlayer player;
+        Surface surface;
+        boolean prepared;
+
+        Slot() {
+            view = new TextureView(ctx);
+            view.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+            view.setSurfaceTextureListener(this);
+        }
+
+        boolean available() {
+            return view.isAvailable();
+        }
+
+        /** Starts clip res on this layer; onReady runs once it plays (onFail when it cannot). */
+        void play(int res, Runnable onReady, Runnable onFail) {
+            release();
+            if (!view.isAvailable()) {
+                if (onFail != null) onFail.run();
+                return;
+            }
+            try {
+                surface = new Surface(view.getSurfaceTexture());
+                player = new MediaPlayer();
+                player.setSurface(surface);
+                player.setVolume(0f, 0f);
+                player.setOnPreparedListener(mp -> {
+                    if (mp != player) return;
+                    prepared = true;
+                    mp.setVolume(0f, 0f);
+                    mp.start();
+                    if (onReady != null) onReady.run();
+                });
+                player.setOnErrorListener((mp, what, extra) -> {
+                    if (mp == player) {
+                        release();
+                        if (onFail != null) onFail.run();
+                    }
+                    return true;
+                });
+                player.setOnCompletionListener(mp -> {
+                    // Reached the end without a cross-fade (the other layer failed): restart here, as before.
+                    if (mp == player && this == front && !crossing) {
+                        mp.seekTo(0);
+                        mp.start();
+                    }
+                });
+                player.setDataSource(ctx, Uri.parse("android.resource://" + ctx.getPackageName() + "/" + res));
+                player.prepareAsync();
+            } catch (Exception e) {
+                release();
+                if (onFail != null) onFail.run();
+            }
+        }
+
+        void release() {
+            prepared = false;
+            if (player != null) {
+                try {
+                    player.release();
+                } catch (Exception ignored) {
+                    // already gone
+                }
+                player = null;
+            }
+            if (surface != null) {
+                surface.release();
+                surface = null;
+            }
+        }
+
+        @Override public void onSurfaceTextureAvailable(SurfaceTexture texture, int w, int h) {
+            if (wanted && this == front && player == null) startFront();
+        }
+
+        @Override public boolean onSurfaceTextureDestroyed(SurfaceTexture texture) {
+            release();
+            return true;
+        }
+
+        @Override public void onSurfaceTextureSizeChanged(SurfaceTexture texture, int w, int h) { }
+        @Override public void onSurfaceTextureUpdated(SurfaceTexture texture) { }
+    }
+
+    private final Context ctx;
+    private final List<Integer> clips = new ArrayList<>();
+    private final long rotationMs;
+    private int index;
+    private long clipStarted;
+    private boolean wanted, crossing;
+    private final Slot bottom, top;
+    private Slot front;
+    private final View shade;
+    private final int dayDim, eveningDim, nightDim;
+    private final android.os.Handler handler = new android.os.Handler(android.os.Looper.getMainLooper());
+    private final Runnable dimTick = new Runnable() {
+        @Override public void run() {
+            updateDim(true);
+            handler.postDelayed(this, 60_000L);
+        }
+    };
+    private final Runnable watch = new Runnable() {
+        @Override public void run() {
+            if (!wanted) return;
+            checkLoop();
+            handler.postDelayed(this, 250);
+        }
+    };
+
+    VideoBackdrop(Context ctx, ViewGroup root, int rotationMinutes, int dimPercent, int eveningDim, int nightDim) {
+        this.ctx = ctx;
+        this.rotationMs = Math.max(1, rotationMinutes) * 60_000L;
+        for (int i = 1; i <= 50; i++) {
+            int id = ctx.getResources().getIdentifier("bg_video_" + i, "raw", ctx.getPackageName());
+            if (id == 0) break;
+            clips.add(id);
+        }
+        Collections.shuffle(clips);
+        bottom = new Slot();
+        top = new Slot();
+        ViewGroup.LayoutParams full = new ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.MATCH_PARENT);
+        root.addView(bottom.view, 0, full);
+        root.addView(top.view, 1, new ViewGroup.LayoutParams(full));
+        top.view.setAlpha(0f);
+        front = bottom;
+        this.dayDim = dimPercent;
+        this.eveningDim = eveningDim;
+        this.nightDim = nightDim;
+        shade = new View(ctx);
+        shade.setBackgroundColor(android.graphics.Color.BLACK);
+        shade.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+        root.addView(shade, 2, new ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.MATCH_PARENT));
+        updateDim(false);
+    }
+
+    /** Darkness over the videos at a minute of the day: day, easing to evening 20-21 h, to night 22-23 h, back 6-7 h. */
+    static float dimAt(int minute, int day, int evening, int night) {
+        int h = minute / 60;
+        float f = (minute % 60) / 60f;
+        if (h >= 23 || h < 6) return night;
+        if (h == 6) return night + (day - night) * f;
+        if (h < 20) return day;
+        if (h == 20) return day + (evening - day) * f;
+        if (h == 21) return evening;
+        return evening + (night - evening) * f;   // 22 h
+    }
+
+    private void updateDim(boolean animate) {
+        java.util.Calendar c = java.util.Calendar.getInstance();
+        float target = dimAt(c.get(java.util.Calendar.HOUR_OF_DAY) * 60 + c.get(java.util.Calendar.MINUTE),
+                dayDim, eveningDim, nightDim) / 100f;
+        if (animate) shade.animate().alpha(target).setDuration(3000).start();
+        else shade.setAlpha(target);
+    }
+
+    void start() {
+        wanted = true;
+        updateDim(false);
+        handler.removeCallbacks(dimTick);
+        handler.postDelayed(dimTick, 60_000L);
+        if (front.player == null && front.available()) startFront();
+        handler.removeCallbacks(watch);
+        handler.postDelayed(watch, 250);
+    }
+
+    void stop() {
+        wanted = false;
+        crossing = false;
+        handler.removeCallbacks(dimTick);
+        handler.removeCallbacks(watch);
+        top.view.animate().cancel();
+        bottom.view.animate().cancel();
+        bottom.release();
+        top.release();
+    }
+
+    /** The clip to play next: the same one, or the next once its rotation time is up. */
+    private int nextClip() {
+        long now = SystemClock.elapsedRealtime();
+        if (clipStarted == 0) {
+            clipStarted = now;
+        } else if (now - clipStarted >= rotationMs && clips.size() > 1) {
+            index = (index + 1) % clips.size();
+            clipStarted = now;
+        }
+        return clips.get(index);
+    }
+
+    private void startFront() {
+        if (clips.isEmpty()) return;
+        Slot other = front == top ? bottom : top;
+        other.release();
+        front.view.setAlpha(1f);
+        other.view.setAlpha(front == bottom ? 0f : 1f);
+        front.play(nextClip(), null, null);
+    }
+
+    /** Near the end of the clip on screen, start the other layer and fade between them. */
+    private void checkLoop() {
+        MediaPlayer p = front.player;
+        if (crossing || p == null || !front.prepared) return;
+        int dur, pos;
+        try {
+            dur = p.getDuration();
+            pos = p.getCurrentPosition();
+        } catch (Exception e) {
+            return;
+        }
+        if (dur <= 0 || dur - pos > PREPARE_BEFORE_END_MS || dur < 2 * PREPARE_BEFORE_END_MS) return;
+        Slot back = front == top ? bottom : top;
+        if (!back.available()) return;
+        crossing = true;
+        back.play(nextClip(), () -> crossFade(back), () -> crossing = false);
+    }
+
+    private void crossFade(Slot incoming) {
+        if (!wanted) return;
+        Slot outgoing = front;
+        long fade = DownDrawer.ms(FADE_MS);
+        Runnable done = () -> {
+            outgoing.release();
+            front = incoming;
+            crossing = false;
+        };
+        if (incoming == top) {
+            // The new clip is on the upper layer: fade it in over the old one.
+            top.view.animate().cancel();
+            top.view.setAlpha(0f);
+            top.view.animate().alpha(1f).setDuration(fade).withEndAction(done).start();
+        } else {
+            // The new clip is underneath: show it and fade the old upper layer away.
+            bottom.view.setAlpha(1f);
+            top.view.animate().cancel();
+            top.view.animate().alpha(0f).setDuration(fade).withEndAction(done).start();
+        }
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/WeatherLine.java b/launcher/app/src/main/java/com/gathin/tvhome/WeatherLine.java
new file mode 100644
index 00000000..071a25cc
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/WeatherLine.java
@@ -0,0 +1,221 @@
+package com.gathin.tvhome;
+
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import android.view.View;
+import android.widget.TextView;
+
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.Locale;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Local addition (theme keys weather_lat / weather_lon): the outdoor temperature as one quiet line under the date.
+ * Asks Open-Meteo (no key, no account) only while Home is in front, at most every 30 minutes; the coordinates are
+ * all that is sent. With no answer the line stays hidden.
+ */
+final class WeatherLine {
+    private static final long REFRESH_MS = 30 * 60_000L;
+    private static final ExecutorService NET = Executors.newSingleThreadExecutor();
+
+    private final TextView view;
+    private final double lat, lon;
+    private final boolean icon;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    /** Last answer, kept across Home being rebuilt (settings, theme, screensaver) so the line never pops in late. */
+    private static String lastText;
+    private static int lastCode = -1;
+    private static long fetchedAt;
+    /** The next hours, as "08 h", symbol, "16°", for the Down panel; empty until the first answer. */
+    private static volatile java.util.List<String[]> hourly = java.util.Collections.emptyList();
+
+    static java.util.List<String[]> hourly() {
+        return hourly;
+    }
+
+    /** The next days, as day name, symbol, "28°", "16°", "40%" (rain chance, "" when none). */
+    private static volatile java.util.List<String[]> daily = java.util.Collections.emptyList();
+
+    static java.util.List<String[]> daily() {
+        return daily;
+    }
+
+    private static String rain(org.json.JSONArray a, int k) {
+        if (a == null || a.isNull(k)) return "";
+        int p = a.optInt(k, 0);
+        return p >= 10 ? p + "%" : "";
+    }
+    private boolean resumed;
+    private final Runnable tick = new Runnable() {
+        @Override public void run() {
+            fetch();
+            handler.postDelayed(this, REFRESH_MS);
+        }
+    };
+
+    WeatherLine(TextView view, double lat, double lon, boolean icon) {
+        this.view = view;
+        this.lat = lat;
+        this.lon = lon;
+        this.icon = icon;
+        // Hold the line's space from the first layout: a line that appears later pushes the dock down under a
+        // focus highlight that was already placed.
+        if (lastText != null) {
+            view.setText(lastText);
+            setIcon(view, icon ? lastCode : -1, 0xA6FFFFFF, 15);
+            view.setVisibility(View.VISIBLE);
+        } else {
+            view.setText(" ");
+            view.setVisibility(View.INVISIBLE);
+        }
+    }
+
+    void resume() {
+        resumed = true;
+        handler.removeCallbacks(tick);
+        long age = SystemClock.elapsedRealtime() - fetchedAt;
+        if (fetchedAt == 0 || age >= REFRESH_MS) {
+            handler.post(tick);
+        } else {
+            handler.postDelayed(tick, REFRESH_MS - age);
+        }
+    }
+
+    void pause() {
+        resumed = false;
+        handler.removeCallbacks(tick);
+    }
+
+    private void fetch() {
+        String url = String.format(Locale.US,
+                "https://api.open-meteo.com/v1/forecast?latitude=%.4f&longitude=%.4f&current=temperature_2m,weather_code&hourly=temperature_2m,weather_code,precipitation_probability&forecast_hours=8&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max&forecast_days=7&timezone=auto",
+                lat, lon);
+        NET.execute(() -> {
+            String text = null;
+            int code = -1;
+            HttpURLConnection c = null;
+            try {
+                c = (HttpURLConnection) new URL(url).openConnection();
+                c.setConnectTimeout(8000);
+                c.setReadTimeout(8000);
+                if (c.getResponseCode() == 200) {
+                    ByteArrayOutputStream out = new ByteArrayOutputStream();
+                    try (InputStream in = c.getInputStream()) {
+                        byte[] buf = new byte[4096];
+                        int n;
+                        while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
+                    }
+                    JSONObject cur = new JSONObject(out.toString("UTF-8")).getJSONObject("current");
+                    long temp = Math.round(cur.getDouble("temperature_2m"));
+                    code = cur.optInt("weather_code", -1);
+                    text = temp + "°";
+                    JSONObject h = new JSONObject(out.toString("UTF-8")).optJSONObject("hourly");
+                    if (h != null) {
+                        org.json.JSONArray times = h.getJSONArray("time");
+                        org.json.JSONArray temps = h.getJSONArray("temperature_2m");
+                        org.json.JSONArray codes = h.getJSONArray("weather_code");
+                        org.json.JSONArray rains = h.optJSONArray("precipitation_probability");
+                        java.util.List<String[]> next = new java.util.ArrayList<>();
+                        for (int k = 1; k < times.length() && next.size() < 6; k++) {   // 0 is the current hour
+                            String t = times.getString(k);   // 2026-10-27T08:00, local time
+                            String hour = t.length() >= 13 ? t.substring(11, 13) + " h" : t;
+                            next.add(new String[]{hour, String.valueOf(codes.optInt(k, -1)), Math.round(temps.getDouble(k)) + "°", rain(rains, k)});
+                        }
+                        hourly = next;
+                    }
+                    JSONObject d = new JSONObject(out.toString("UTF-8")).optJSONObject("daily");
+                    if (d != null) {
+                        org.json.JSONArray days = d.getJSONArray("time");
+                        org.json.JSONArray hi = d.getJSONArray("temperature_2m_max");
+                        org.json.JSONArray lo = d.getJSONArray("temperature_2m_min");
+                        org.json.JSONArray dc = d.getJSONArray("weather_code");
+                        org.json.JSONArray dr = d.optJSONArray("precipitation_probability_max");
+                        java.util.List<String[]> next = new java.util.ArrayList<>();
+                        for (int k = 0; k < days.length(); k++) {
+                            String name;
+                            if (k == 0) {
+                                name = view.getContext().getString(R.string.forecast_today);
+                            } else {
+                                name = java.time.LocalDate.parse(days.getString(k)).getDayOfWeek()
+                                        .getDisplayName(java.time.format.TextStyle.SHORT, Locale.getDefault()).replace(".", "");
+                                name = name.substring(0, 1).toUpperCase(Locale.getDefault()) + name.substring(1);
+                            }
+                            next.add(new String[]{name, String.valueOf(dc.optInt(k, -1)), Math.round(hi.getDouble(k)) + "°",
+                                    Math.round(lo.getDouble(k)) + "°", rain(dr, k)});
+                        }
+                        daily = next;
+                    }
+                }
+            } catch (Exception ignored) {
+                // Offline or a bad answer: keep whatever is shown, or nothing.
+            } finally {
+                if (c != null) c.disconnect();
+            }
+            final String shown = text;
+            final int shownCode = code;
+            handler.post(() -> {
+                if (shown == null) return;
+                fetchedAt = SystemClock.elapsedRealtime();
+                lastText = shown;
+                lastCode = shownCode;
+                view.setText(shown);
+                setIcon(view, icon ? shownCode : -1, 0xA6FFFFFF, 15);
+                view.setVisibility(View.VISIBLE);
+            });
+        });
+    }
+
+    /** WMO weather code to one of the line icons drawn for this build (0 when unknown). */
+    static int iconFor(int code) {
+        if (code < 0) return 0;
+        if (code <= 1) return R.drawable.ic_wx_sun;
+        if (code == 2) return R.drawable.ic_wx_cloud_sun;
+        if (code == 3) return R.drawable.ic_wx_cloud;
+        if (code == 45 || code == 48) return R.drawable.ic_wx_fog;
+        if (code >= 71 && code <= 77 || code == 85 || code == 86) return R.drawable.ic_wx_snow;
+        if (code >= 95) return R.drawable.ic_wx_storm;
+        if (code >= 51) return R.drawable.ic_wx_rain;
+        return R.drawable.ic_wx_cloud;
+    }
+
+    static int iconFor(String code) {
+        try {
+            return iconFor(Integer.parseInt(code));
+        } catch (Exception e) {
+            return 0;
+        }
+    }
+
+    /** Puts the weather icon before the text, tinted like it, sizeDp tall; none when code is unknown. */
+    static void setIcon(TextView v, int code, int color, int sizeDp) {
+        int res = iconFor(code);
+        android.graphics.drawable.Drawable d = res == 0 ? null : v.getContext().getDrawable(res);
+        if (d != null) {
+            d = d.mutate();
+            d.setTint(color);
+            int px = Math.round(sizeDp * v.getResources().getDisplayMetrics().density);
+            d.setBounds(0, 0, px, px);
+            v.setCompoundDrawablePadding(Math.round(6 * v.getResources().getDisplayMetrics().density));
+        }
+        v.setCompoundDrawablesRelative(d, null, null, null);
+    }
+
+    static String symbol(int code) {
+        if (code < 0) return "";
+        if (code <= 1) return "☀︎";
+        if (code == 2) return "⛅︎";
+        if (code == 3) return "☁︎";
+        if (code == 45 || code == 48) return "≋";
+        if (code >= 71 && code <= 77 || code == 85 || code == 86) return "❄︎";
+        if (code >= 95) return "⚡︎";
+        if (code >= 51) return "☂︎";
+        return "";
+    }
+}
