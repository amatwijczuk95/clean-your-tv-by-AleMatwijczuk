<?xml version="1.0" encoding="utf-8"?>
<!-- Local: the launcher settings as a TV menu, a frosted panel on the right over the dimmed Home. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/settingsPanel"
        android:layout_width="500dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/settings_panel_bg"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/settingsColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="34dp"
            android:paddingBottom="34dp">

            <TextView
                android:id="@+id/settingsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:drawableStart="@drawable/ic_settings"
                android:drawablePadding="14dp"
                android:drawableTint="#FFFFFFFF"
                android:gravity="center_vertical"
                android:text="@string/launcher_settings"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp"
                android:fontFamily="@string/font_regular" />

            <TextView
                android:id="@+id/settingsSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="52dp"
                android:textColor="#8CFFFFFF"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="#1FFFFFFF" />

            <TextView android:id="@+id/reorderChoice" style="@style/SettingsRow" android:drawableStart="@drawable/ic_swap_vert" android:text="@string/reorder" android:visibility="gone" />

            <TextView style="@style/SettingsSection" android:text="@string/section_screen" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:paddingEnd="8dp"
                android:orientation="horizontal">
                <TextView style="@style/SettingsChoiceLabel" android:text="@string/columns_label" android:drawableStart="@drawable/ic_tv_grid" />
                <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
                <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
                <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
                <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:paddingEnd="8dp"
                android:orientation="horizontal">
                <TextView style="@style/SettingsChoiceLabel" android:text="@string/rows_below_dock_label" android:drawableStart="@drawable/ic_tv_apps" />
                <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
                <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
                <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
                <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:paddingEnd="8dp"
                android:orientation="horizontal">
                <TextView style="@style/SettingsChoiceLabel" android:text="@string/dock_opacity_label" android:drawableStart="@drawable/ic_tv_image" />
                <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100" />
                <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70" />
                <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50" />
                <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30" />
            </LinearLayout>

            <TextView style="@style/SettingsSection" android:text="@string/section_background" />
            <TextView android:id="@+id/wallpaperChoice" style="@style/SettingsRow" android:drawableStart="@drawable/ic_tv_image" />
            <TextView android:id="@+id/videoChoice" style="@style/SettingsRow" android:drawableStart="@drawable/ic_tv_video" />
            <TextView android:id="@+id/nightBrightnessChoice" style="@style/SettingsRow" android:drawableStart="@drawable/ic_tv_sun" />

            <TextView style="@style/SettingsSection" android:text="@string/section_effects" />
            <TextView android:id="@+id/animationsChoice" style="@style/SettingsRow" android:drawableStart="@drawable/ic_tv_sparkle" />
            <TextView android:id="@+id/advancedChoice" style="@style/SettingsRow" android:drawableStart="@drawable/ic_tv_sparkle" />
            <TextView style="@style/SettingsHint" android:text="@string/advanced_effects_warning" />

            <TextView style="@style/SettingsSection" android:text="@string/section_system" />
            <TextView android:id="@+id/openOnStartChoice" style="@style/SettingsRow" android:drawableStart="@drawable/ic_home_settings_pill" android:visibility="gone" />
            <TextView android:id="@+id/followThemeChoice" style="@style/SettingsRow" android:drawableStart="@drawable/ic_tv_reset" android:text="@string/follow_theme" />
            <TextView style="@style/SettingsHint" android:text="@string/follow_theme_hint" />
            <TextView android:id="@+id/defaultHomeChoice" style="@style/SettingsRow" android:drawableStart="@drawable/ic_home_settings_pill" android:text="@string/home_settings" />
            <TextView style="@style/SettingsHint" android:text="@string/home_settings_help" />
            <TextView android:id="@+id/tvSettingsChoice" style="@style/SettingsRow" android:drawableStart="@drawable/ic_settings" android:text="@string/tv_settings" />

            <TextView
                android:id="@+id/settingsFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:textColor="#4DFFFFFF"
                android:textSize="12sp"
                android:letterSpacing="0.06" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
