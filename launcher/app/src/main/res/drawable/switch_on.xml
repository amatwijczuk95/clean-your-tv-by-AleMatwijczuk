<?xml version="1.0" encoding="utf-8"?>
<!-- Local: a TV menu toggle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="44dp" android:height="26dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF34C759" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:width="20dp" android:height="20dp" android:gravity="end|center_vertical" android:start="3dp" android:end="3dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
